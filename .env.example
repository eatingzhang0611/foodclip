# 复制成 .env 后填写。注意：模型必须支持图片输入（视觉）。
#
# ⚠️ DeepSeek 目前不支持传图（V4 仍是纯文本，识图模式还在灰度未开放 API）。
#    你的 DeepSeek key 在这一步用不了，需要换一家有视觉能力的。

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 城市，用于给点评深链加限定词，避免同名店搜错（如「东京屋」）。留空则从视频文案里猜。
CITY=上海

# 处理一条要 1~5 分钟，快捷指令等不了那么久，靠 ntfy 推送真实结果。留空则不推送。
# 服务器和 LLM 接口跨国时（比如 VPS 在海外、模型在国内）尤其需要，处理时间会更长。
# TOPIC 建议随机生成（ntfy.sh 是公共服务器，topic 名字即凭证，别用简单词）。
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# 清单页的公网地址，拼进 Bark 通知里点开直达。留空则通知不带链接。
PUBLIC_URL=


# ── 可选的几家，任选其一填到上面 ──────────────────────────────
#
# 豆包（推荐：国内延迟低、视觉便宜，控制台开通「视觉理解」后拿 endpoint id）
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=doubao-seed-1-6-vision       # 或你的 ep-xxxx endpoint
#
# 通义千问（阿里云百炼，有免费额度）
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-vl-max-latest
#
# 智谱 GLM
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4v-plus
#
# Kimi（月之暗面）
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k-vision-preview
#
# Claude（海外，需自备网络）
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-sonnet-5
